# Base de la API. En desarrollo (cross-origin) apunta al backend local.
# En un dominio/subdominio puede dejarse vacío para usar el mismo origen del
# frontend (reverse proxy que sirve /api). No fijar localhost en staging/prod.
VITE_API_URL=http://localhost:8080

# Client ID OAuth de Google (vacío = botón de Google deshabilitado).
VITE_GOOGLE_CLIENT_ID=
