# Copiar a .env y ajustar según entorno.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
# URL del frontend (para enlaces de activación que se envían por correo).
app.frontendUrl = 'http://localhost:5173'

# Administrador inicial creado por SystemSeeder (`php spark db:seed SystemSeeder`).
# Sin INITIAL_ADMIN_PASSWORD el seeder no crea la cuenta. El .env real no se versiona.
INITIAL_ADMIN_USERNAME = MDJLO-SOL
INITIAL_ADMIN_PASSWORD =

# MySQL local (docker-compose) u otro servidor.
database.default.hostname = 127.0.0.1
database.default.database = sistema_empleo
database.default.username = empleo
database.default.password = empleo123
database.default.DBDriver = MySQLi
database.default.port = 3306

# Clave para firmar JWT y duraciones de sesión (rotar en producción).
jwt.secret = cambie-esta-clave-en-produccion
jwt.accessExpiresMinutes = 120
jwt.refreshExpiresDays = 15

# Almacenamiento de CV (RT-CV). driver: local | supabase
storage.driver = local
supabase.url =
supabase.anonKey =
supabase.serviceRole =
storage.bucket = cvs

# Verificación de RUC (auto-registro de empresas). Token de apis.net.pe.
sunat.token =

# Correo SMTP para notificaciones a empresas (aprobación/rechazo + enlace de
# activación). Con email.host vacío no se envía; el admin usa el enlace interno.
email.protocol = smtp
email.host =
email.port = 587
email.user =
email.pass =
email.crypto = tls
email.fromEmail =
email.fromName = 'Empleo MDJLO'

# Días de vigencia del enlace de activación de cuenta.
activacion.expiraDias = 7

# Google Sign-In (registro/ingreso de postulantes). Client ID de OAuth 2.0.
google.clientId =
