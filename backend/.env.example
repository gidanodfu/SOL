# Copiar a .env y ajustar según entorno.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
# URL pública del frontend, usada para construir los enlaces de activación que se
# envían por correo. Configurable por entorno (nunca hardcodeada): en producción
# apuntar al dominio real (p. ej. https://empleo.midominio.gob.pe). Se acepta
# APP_URL (preferido) o app.frontendUrl (alias).
APP_URL = 'http://localhost:5173'
app.frontendUrl = 'http://localhost:5173'

# Zona horaria de la operación. Por defecto America/Lima (Perú, UTC-5):
# fechas de publicación/cierre y reportes se calculan en horario de negocio.
app.appTimezone = America/Lima

# CORS: orígenes exactos del frontend (separados por coma) y, opcionalmente,
# patrones regex para admitir subdominios (p. ej. https://\w+\.midominio\.gob\.pe).
cors.allowedOrigins = http://localhost:5173
cors.allowedOriginsPatterns =

# Administrador inicial creado por SystemSeeder (`php spark db:seed SystemSeeder`).
# Sin INITIAL_ADMIN_PASSWORD el seeder no crea la cuenta. El .env real no se versiona.
INITIAL_ADMIN_USERNAME = MDJLO-SOL
INITIAL_ADMIN_PASSWORD =

# MySQL local (docker-compose) u otro servidor.
database.default.hostname = 127.0.0.1
database.default.database = sistema_empleo
database.default.username = empleo
database.default.password = empleo123
database.default.DBDriver = MySQLi
database.default.port = 3306

# Clave para firmar JWT y duraciones de sesión (rotar en producción).
jwt.secret = cambie-esta-clave-en-produccion
jwt.accessExpiresMinutes = 120
jwt.refreshExpiresDays = 15

# Almacenamiento de CV (RT-CV). driver: local | supabase
storage.driver = local
supabase.url =
supabase.anonKey =
supabase.serviceRole =
storage.bucket = cvs

# Verificación de RUC (auto-registro de empresas). Token de apis.net.pe.
sunat.token =

# Verificación de DNI (RENIEC) al registrar postulantes. PROVEEDOR EXCLUSIVO: JSON.pe
# (POST https://api.json.pe/api/dni). Token dedicado de JSON.pe. Si se deja vacío,
# se reutiliza dni.token (compatibilidad). NO usar aquí el token de Decolecta.
jsonpe.token =
dni.token =

# Envío de correo con Resend (SDK oficial PHP). Es el motor principal; si no hay
# clave configurada, se usa SMTP (email.*) como respaldo. La API key es SOLO del
# backend: nunca al frontend, nunca en logs, nunca en el código.
# Preferido: RESEND_API_KEY + RESEND_FROM_NAME + RESEND_FROM_EMAIL.
# Compatibilidad: resend.apiKey + resend.from (alias, se siguen aceptando).
RESEND_API_KEY =
RESEND_FROM_NAME = 'Empleo MDJLO'
# En desarrollo se permite el remitente sandbox de Resend (solo envía al correo
# del propietario de la cuenta). En producción, para enviar a cualquier
# destinatario, verificar un dominio en https://resend.com/domains y cambiar
# ÚNICAMENTE esta variable (sin tocar código):
#   RESEND_FROM_EMAIL = no-reply@mi-dominio-verificado
#   (o la forma completa: RESEND_FROM_EMAIL = "Empleo MDJLO <no-reply@mi-dominio-verificado>")
RESEND_FROM_EMAIL = onboarding@resend.dev
resend.apiKey =
resend.from = 'Empleo MDJLO <onboarding@resend.dev>'

# Correo SMTP (respaldo de Resend). Con email.host vacío no se envía; el admin
# usa el enlace interno de activación.
email.protocol = smtp
email.host =
email.port = 587
email.user =
email.pass =
email.crypto = tls
email.fromEmail =
email.fromName = 'Empleo MDJLO'

# Días de vigencia del enlace de activación de cuenta.
activacion.expiraDias = 7

# Google Sign-In (registro/ingreso de postulantes). Client ID de OAuth 2.0.
google.clientId =
