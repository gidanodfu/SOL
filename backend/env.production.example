# Configuración de ejemplo para PRODUCCIÓN.
# Copiar a .env en el servidor y ajustar. No subir a git.
CI_ENVIRONMENT = production

app.baseURL = 'https://empleo.mdjlo.gob.pe/'
app.forceGlobalSecureRequests = true

# Administrador inicial creado por SystemSeeder (`php spark db:seed SystemSeeder`).
# Definir la contraseña en el servidor; el seeder la guarda con hash. Cámbiela tras el primer acceso.
INITIAL_ADMIN_USERNAME = MDJLO-SOL
INITIAL_ADMIN_PASSWORD =

# MySQL de producción.
database.default.hostname = 127.0.0.1
database.default.database = sistema_empleo
database.default.username = usuario_prod
database.default.password = clave_segura
database.default.DBDriver = MySQLi
database.default.port = 3306

# JWT: clave larga y aleatoria; expiración acorde a la operación.
jwt.secret = CAMBIAR-clave-secreta-de-64-caracteres-aleatoria
jwt.accessExpiresMinutes = 60
jwt.refreshExpiresDays = 7

# CORS: dominio(s) del frontend desplegado (coma separado).
cors.allowedOrigins = https://empleo.mdjlo.gob.pe

# Almacenamiento de CV: Supabase Storage con su API compatible con S3 (RT-CV).
# driver: supabase | local
storage.driver = supabase
storage.bucket = cvs
s3.endpoint = https://TU-PROYECTO.storage.supabase.co/storage/v1/s3
s3.accessKey = access-key-s3-del-bucket
s3.secretKey = secret-key-s3-SOLO-BACKEND
s3.region = us-west-2

# URL pública del frontend: se usa para armar el enlace de activación de empresas.
app.frontendUrl = https://empleo.mdjlo.gob.pe

# Verificación de RUC en el auto-registro de empresas (apis.net.pe / decolecta).
sunat.token =

# SMTP para notificar aprobación/rechazo y enlace de activación. Con email.host vacío
# no se envía correo y el admin entrega el enlace desde la bandeja de solicitudes.
email.protocol = smtp
email.host = smtp.gob.pe
email.port = 587
email.user = correo-notificador
email.pass = clave-segura
email.crypto = tls
email.fromEmail = empleo@mdjlo.gob.pe
email.fromName = 'Empleo MDJLO'

# Google Sign-In para postulantes (client ID OAuth 2.0; el frontend usa el mismo en
# VITE_GOOGLE_CLIENT_ID y debe autorizar el origen del sitio en la consola de Google).
google.clientId =

# Vigencia del enlace de activación (días).
activacion.expiraDias = 7
