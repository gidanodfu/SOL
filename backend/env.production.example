# Configuración de ejemplo para PRODUCCIÓN.
# Copiar a .env en el servidor y ajustar. No subir a git.
CI_ENVIRONMENT = production

app.baseURL = 'https://empleo.mdjlo.gob.pe/'
app.forceGlobalSecureRequests = true

# Administrador inicial creado por SystemSeeder (`php spark db:seed SystemSeeder`).
# Definir la contraseña en el servidor; el seeder la guarda con hash. Cámbiela tras el primer acceso.
INITIAL_ADMIN_USERNAME = MDJLO-SOL
INITIAL_ADMIN_PASSWORD =

# MySQL de producción.
database.default.hostname = 127.0.0.1
database.default.database = sistema_empleo
database.default.username = usuario_prod
database.default.password = clave_segura
database.default.DBDriver = MySQLi
database.default.port = 3306

# JWT: clave larga y aleatoria; expiración acorde a la operación.
jwt.secret = CAMBIAR-clave-secreta-de-64-caracteres-aleatoria
jwt.accessExpiresMinutes = 60
jwt.refreshExpiresDays = 7

# CORS: dominio(s) del frontend desplegado (coma separado). Opcionalmente,
# cors.allowedOriginsPatterns admite subdominios con expresiones regulares.
cors.allowedOrigins = https://empleo.mdjlo.gob.pe
cors.allowedOriginsPatterns =

# Zona horaria de la operación (horario de negocio de Perú). El MySQL del
# servidor debería usar la misma zona (o UTC y convertir en las fronteras).
app.appTimezone = America/Lima

# Almacenamiento de CV: Supabase Storage con su API compatible con S3 (RT-CV).
# driver: supabase | local
storage.driver = supabase
storage.bucket = cvs
s3.endpoint = https://TU-PROYECTO.storage.supabase.co/storage/v1/s3
s3.accessKey = access-key-s3-del-bucket
s3.secretKey = secret-key-s3-SOLO-BACKEND
s3.region = us-west-2

# URL pública del frontend: se usa para armar el enlace de activación de empresas.
app.frontendUrl = https://empleo.mdjlo.gob.pe

# Verificación de RUC en el auto-registro de empresas (apis.net.pe / decolecta).
sunat.token =

# Verificación de DNI (RENIEC) al registrar postulantes. Si se omite, usa sunat.token.
dni.token =

# Envío de correo con Resend (SDK oficial PHP): motor principal. La API key es
# EXCLUSIVAMENTE del backend. En producción usar un remitente de dominio verificado
# (no onboarding@resend.dev). Si no hay clave, se usa SMTP (email.*).
# Preferido: RESEND_API_KEY + RESEND_FROM_NAME + RESEND_FROM_EMAIL.
# Verificar el dominio en https://resend.com/domains y usar un remitente del
# dominio verificado (no onboarding@resend.dev). Cambiar solo RESEND_FROM_EMAIL.
RESEND_API_KEY =
RESEND_FROM_NAME = 'Empleo MDJLO'
RESEND_FROM_EMAIL = no-reply@TU-DOMINIO-VERIFICADO
# Alternativamente, la forma completa en una sola variable:
# RESEND_FROM_EMAIL = "Empleo MDJLO <no-reply@TU-DOMINIO-VERIFICADO>"

# SMTP (respaldo de Resend) para notificar aprobación/rechazo y enlace de activación.
# Con email.host vacío no se envía correo y el admin entrega el enlace desde la bandeja.
email.protocol = smtp
email.host = smtp.gob.pe
email.port = 587
email.user = correo-notificador
email.pass = clave-segura
email.crypto = tls
email.fromEmail = empleo@mdjlo.gob.pe
email.fromName = 'Empleo MDJLO'

# Google Sign-In para postulantes (client ID OAuth 2.0; el frontend usa el mismo en
# VITE_GOOGLE_CLIENT_ID y debe autorizar el origen del sitio en la consola de Google).
google.clientId =

# Vigencia del enlace de activación (días).
activacion.expiraDias = 7

# Cloudflare Turnstile para el login (usuario + contraseña). La Secret Key es
# EXCLUSIVAMENTE del backend (nunca al frontend ni a variables VITE_*). La
# sitekey es pública y va en el frontend como VITE_TURNSTILE_SITE_KEY.
# hostnames: dominios del frontend donde se permite el token (coma separado).
turnstile.enabled = true
turnstile.siteKey =
turnstile.secretKey =
turnstile.action = login
turnstile.hostnames = empleo.mdjlo.gob.pe
