# Modalidad HTTP con frontend y API en subdominios separados (gateway interno
# detrás de Traefik). Generado por render.sh; no editar el archivo generado.
#
# El host del frontend no sirve /api y el host de la API no sirve el frontend.
# Solo Traefik puede alcanzar este Nginx, y X-Forwarded-* solo se confía desde
# su IP fija en la red de entrada exclusiva.
map $http_x_forwarded_proto $sol_https {
    default off;
    https   on;
}
map $http_x_forwarded_proto $sol_forwarded_proto {
    default http;
    https   https;
}
# $realip_remote_addr conserva el par original aunque real_ip sustituya
# $remote_addr por la IP del cliente. Solo el propio Nginx y Traefik pueden
# abrir una conexión directa al gateway.
geo $realip_remote_addr $sol_edge_allowed {
    default 0;
    127.0.0.1/32 1;
    ::1/128 1;
    ${TRAEFIK_ENTRY_IP}/32 1;
}

# Un Host no declarado no debe caer accidentalmente en el frontend.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};
    server_tokens off;
    client_max_body_size 12m;

    if ($sol_edge_allowed = 0) {
        return 403;
    }

    set_real_ip_from ${TRAEFIK_ENTRY_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    # En subdominios la API vive en API_DOMAIN, no en el host del frontend.
    location ^~ /api {
        return 404;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sol_forwarded_proto;
    }
}

server {
    listen 80;
    server_name ${API_DOMAIN};
    server_tokens off;
    client_max_body_size 12m;

    if ($sol_edge_allowed = 0) {
        return 403;
    }

    set_real_ip_from ${TRAEFIK_ENTRY_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    # El host de API no tiene fallback al frontend.
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/sol/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/sol/backend/public;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param PATH_INFO $uri;
        fastcgi_param HTTP_X_FORWARDED_PROTO $sol_forwarded_proto;
        fastcgi_param HTTPS $sol_https;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_pass backend:9000;
        fastcgi_read_timeout 60s;
    }
}
