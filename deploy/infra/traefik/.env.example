# Infraestructura compartida de Traefik
# Copiar a .env (no versionado) y completar el correo ACME.
# No se publica el dashboard de Traefik.

TRAEFIK_PROJECT_NAME=sol_infra
PROXY_NETWORK=proxy
# Debe coincidir con la subred de la red compartida proxy. No se usa para
# confiar en X-Forwarded-*; esa confianza se limita a TRAEFIK_ENTRY_IP.
PROXY_SUBNET=172.30.0.0/24
# Red exclusiva Traefik ↔ Nginx de SOL. Solo estos dos contenedores deben
# unirse; Traefik usa una IP fija para que SOL pueda confiar únicamente en ella.
SOL_ENTRY_NETWORK=sol_entry
SOL_ENTRY_SUBNET=172.31.0.0/29
TRAEFIK_ENTRY_IP=172.31.0.2
# Red privada solo para socket-proxy ↔ Traefik.
TRAEFIK_SOCKET_NETWORK=traefik_socket
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Correo para Let's Encrypt (obligatorio; no es una contraseña).
ACME_EMAIL=
# Producción: https://acme-v02.api.letsencrypt.org/directory
# Pruebas: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
