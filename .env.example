# ============================================================================
# SOL — plantilla de configuración centralizada
# Copiar a .env en la raíz del repositorio y completar los valores reales.
# El archivo .env NO se versiona. Nunca guarde secretos en este ejemplo.
# ============================================================================

# ---------------------------------------------------------------------------
# Entorno y aplicación
# ---------------------------------------------------------------------------
# development | testing | production
CI_ENVIRONMENT=development
TZ=America/Lima
# Identifica el proyecto Compose y aísla redes/volúmenes. En producción use
# un valor distinto, por ejemplo sol_prod; deploy.sh/bootstrap.sh rechazan
# sol_dev para --prod.
COMPOSE_PROJECT_NAME=sol_dev
# Red de entrada exclusiva entre Traefik y el Nginx de borde de SOL.
# Solo Traefik y este Nginx deben unirse. Traefik usa la IP fija indicada en
# TRAEFIK_ENTRY_IP; Nginx solo confía en esa IP para X-Forwarded-For/Proto.
# La red y la subred se crean en deploy/infra/traefik.
SOL_ENTRY_NETWORK=sol_entry
TRAEFIK_ENTRY_IP=172.31.0.2
# Opcional: nombre de un Traefik compartido ya existente que no tenga la
# label com.sol.infra=traefik. Déjelo vacío para el Traefik de deploy/infra.
TRAEFIK_CONTAINER=

# Dominios que usará Traefik en producción (en desarrollo pueden ser localhost).
# Si APP_DOMAIN y API_DOMAIN son iguales, Nginx sirve frontend y API en el
# mismo host. Si son distintos, el host de API solo enruta a la API y no
# devuelve el frontend.
APP_DOMAIN=localhost
API_DOMAIN=localhost
# En producción detrás de Traefik: NGINX_MODE=http (TLS termina en Traefik).
# Los modos same-domain/subdomain quedan como legado para un Nginx standalone.
NGINX_MODE=http

# Variables legado para un Nginx standalone. En producción con Traefik los
# certificados y la terminación TLS viven en deploy/infra/traefik.
TLS_CERTS_DIR=./nginx/certs
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# URL pública del frontend (enlaces de activación de empresas).
APP_URL=http://localhost:5173
# URL pública de la API. En same-domain puede ser el mismo dominio + /.
app.baseURL=http://localhost:8080/
app.forceGlobalSecureRequests=false
app.CSPEnabled=false
app.appTimezone=America/Lima

# Orígenes del frontend permitidos por la API (separados por coma).
cors.allowedOrigins=http://localhost:5173
cors.allowedOriginsPatterns=

# Puertos publicados solo en el host para el entorno de desarrollo.
DEV_API_PORT=8080
DEV_FRONTEND_PORT=5173
DEV_DB_PORT=3307
DEV_ADMINER_PORT=8082

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# DB_HOST/DB_PORT se usan desde el host. Docker Compose sobreescribe el host
# a "db" y el puerto a 3306 dentro de la red interna.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=sistema_empleo
DB_USER=empleo
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_DRIVER=MySQLi
DB_PREFIX=


# ---------------------------------------------------------------------------
# Seguridad y sesión
# ---------------------------------------------------------------------------
# Generar una clave segura dentro del contenedor:
#   ./deploy/scripts/dev.sh exec backend php spark key:generate
encryption.key=
jwt.secret=cambie-esta-clave-por-una-aleatoria-de-64-caracteres
jwt.accessExpiresMinutes=120
jwt.refreshExpiresDays=15

# Administrador inicial: solo se usa en la primera instalación.
# La contraseña debe tener al menos 8 caracteres, letra, número y símbolo.
# Dejar vacío en .env.example; completar solo en el .env privado.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Almacenamiento de CV
# ---------------------------------------------------------------------------
# local | supabase
storage.driver=local
# Nombre real del bucket privado; `cvs` es solo un ejemplo.
storage.bucket=cvs
s3.endpoint=
s3.accessKey=
s3.secretKey=
s3.region=us-east-1

# ---------------------------------------------------------------------------
# Verificación de identidad (RUC/RENIEC)
# ---------------------------------------------------------------------------
sunat.token=
# Proveedor de DNI preferido: JSON.pe
jsonpe.token=

# ---------------------------------------------------------------------------
# Correo (Resend y SMTP de respaldo)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_NAME='Empleo MDJLO'
RESEND_FROM_EMAIL=no-reply@su-dominio-verificado.example
EMAIL_BRAND_NAME=
EMAIL_BRAND_SUBTITLE=

email.protocol=smtp
email.host=
email.port=587
email.user=
email.pass=
email.crypto=tls
email.fromEmail=
email.fromName='Empleo MDJLO'

activacion.expiraDias=7

# ---------------------------------------------------------------------------
# Google OAuth y Cloudflare Turnstile
# ---------------------------------------------------------------------------
# Google: configure google.clientId y VITE_GOOGLE_CLIENT_ID con el MISMO
# cliente web, o deje ambos vacíos para deshabilitar el ingreso con Google.
# Los orígenes autorizados se configuran en Google Cloud Console, no aquí:
#   desarrollo: http://localhost:5173
#   producción: https://<APP_DOMAIN>
# Si cambia VITE_GOOGLE_CLIENT_ID, reconstruya el frontend.
google.clientId=

# En local puede quedar false si no se configuran credenciales de prueba.
# En producción debe ser true y exige secret key, site key y el hostname exacto.
turnstile.enabled=false
# La secret key es exclusivamente del backend.
turnstile.secretKey=
turnstile.action=login
# Lista sin protocolo, ruta ni puerto; en producción debe incluir APP_DOMAIN.
# Ejemplo de desarrollo: localhost,127.0.0.1
turnstile.hostnames=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Frontend (Vite): SOLO variables públicas con prefijo VITE_
# ---------------------------------------------------------------------------
# En producción con same-domain puede quedar vacío para usar el mismo origen.
# En subdominios debe ser la URL explícita de la API. Es una variable de
# compilación de Vite: después de cambiarla hay que reconstruir el frontend.
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=

# ============================================================================
# Notas de producción
# ============================================================================
# 1. Cambie CI_ENVIRONMENT, APP_DOMAIN, API_DOMAIN, APP_URL y app.baseURL.
# 2. Use DB_PASSWORD y DB_ROOT_PASSWORD distintas a desarrollo.
# 3. Use un jwt.secret y encryption.key exclusivos de producción.
# 4. Configure storage.driver=supabase y las claves S3 del bucket privado.
# 5. Para same-domain: VITE_API_URL= y app.baseURL=https://APP_DOMAIN/.
# 6. Para subdomain: VITE_API_URL=https://API_DOMAIN y
#    app.baseURL=https://API_DOMAIN/; agregue APP_DOMAIN a cors.allowedOrigins.
# 7. En producción detrás de Traefik: NGINX_MODE=http; APP_URL y app.baseURL
#    deben ser https. TLS y ACME se configuran en deploy/infra/traefik.
# 8. No use las credenciales de ejemplo ni valores predeterminados en producción.
# 9. Use COMPOSE_PROJECT_NAME=sol_prod (o un nombre único) y un .env distinto
#    al de desarrollo; los scripts rechazan sol_dev para --prod.
# 10. Instalación nueva: ./deploy/scripts/bootstrap.sh --prod --authorize
# 11. Actualización: ./deploy/scripts/deploy.sh (no ejecuta seeders).
# 12. Respaldos/restauración: ./deploy/scripts/backup.sh prod y
#     ./deploy/scripts/restore.sh --env prod ... --allow-production.
# 13. Despliegue primero deploy/infra/traefik; después SOL. SOL_ENTRY_NETWORK
#     y TRAEFIK_ENTRY_IP deben coincidir con esa infraestructura (red
#     exclusiva Traefik ↔ Nginx de SOL; por defecto sol_entry y 172.31.0.2).
# 14. En subdominios, APP_DOMAIN y API_DOMAIN deben ser distintos; el host de
#     API no sirve el frontend. En dominio único, use el mismo valor en ambos.
# 15. En producción Turnstile debe estar habilitado con site key, secret key y
#     turnstile.hostnames incluyendo APP_DOMAIN. Google exige ambos IDs iguales
#     o ambos vacíos; VITE_GOOGLE_CLIENT_ID es de compilación de Vite.
