# ============================================================================
# SOL — plantilla de configuración para desarrollo local
# Copiar a .env en la raíz del repositorio y completar los valores reales.
# El archivo .env NO se versiona. Nunca guarde secretos en este ejemplo.
# ============================================================================

# ---------------------------------------------------------------------------
# Entorno y aplicación
# ---------------------------------------------------------------------------
CI_ENVIRONMENT=development
TZ=America/Lima
# Identifica el proyecto Compose y aísla redes/volúmenes locales.
COMPOSE_PROJECT_NAME=sol_dev

# Puertos publicados solo en 127.0.0.1.
DEV_API_PORT=8080
DEV_FRONTEND_PORT=5173
DEV_DB_PORT=3307
DEV_ADMINER_PORT=8082

# URL local del frontend y de la API.
APP_URL=http://localhost:5173
app.baseURL=http://localhost:8080/
app.forceGlobalSecureRequests=false
app.CSPEnabled=false
app.appTimezone=America/Lima

# Orígenes del frontend permitidos por la API (separados por coma).
cors.allowedOrigins=http://localhost:5173
cors.allowedOriginsPatterns=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# DB_HOST/DB_PORT se usan desde el host. Dentro de Compose, el backend usa
# db:3306 y MySQL publica 127.0.0.1:${DEV_DB_PORT}.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=sistema_empleo
DB_USER=empleo
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_DRIVER=MySQLi
DB_PREFIX=


# ---------------------------------------------------------------------------
# Seguridad y sesión
# ---------------------------------------------------------------------------
# Generar claves locales dentro del contenedor:
#   ./deploy/scripts/dev.sh exec backend php spark key:generate
encryption.key=
jwt.secret=cambie-esta-clave-por-una-aleatoria-de-64-caracteres
jwt.accessExpiresMinutes=120
jwt.refreshExpiresDays=15

# Administrador inicial: solo se usa en bootstrap.sh.
# La contraseña debe tener al menos 8 caracteres, letra, número y símbolo.
# Dejar vacío en .env.example; completar solo en el .env privado.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Almacenamiento de CV
# ---------------------------------------------------------------------------
# local | supabase
# Para desarrollo local use `local`; Supabase es opcional.
storage.driver=local
# Nombre real del bucket privado si usa Supabase; `cvs` es solo un ejemplo.
storage.bucket=cvs
s3.endpoint=
s3.accessKey=
s3.secretKey=
s3.region=us-east-1

# Rate limiting de carga de CV (ventanas fijas).
# Límite por usuario (protección principal) y por IP (complemento).
# Valores en segundos.
cvRateLimit.userShortLimit=5
cvRateLimit.userShortWindow=600
cvRateLimit.userLongLimit=20
cvRateLimit.userLongWindow=3600
cvRateLimit.ipShortLimit=10
cvRateLimit.ipShortWindow=600
cvRateLimit.ipLongLimit=40
cvRateLimit.ipLongWindow=3600

# ---------------------------------------------------------------------------
# Verificación de identidad (RUC/RENIEC)
# ---------------------------------------------------------------------------
sunat.token=
# Proveedor de DNI preferido: JSON.pe
jsonpe.token=

# ---------------------------------------------------------------------------
# Correo (Resend y SMTP de respaldo)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_NAME='Empleo MDJLO'
RESEND_FROM_EMAIL=no-reply@su-dominio-verificado.example
EMAIL_BRAND_NAME=
EMAIL_BRAND_SUBTITLE=

email.protocol=smtp
email.host=
email.port=587
email.user=
email.pass=
email.crypto=tls
email.fromEmail=
email.fromName='Empleo MDJLO'

activacion.expiraDias=7

# ---------------------------------------------------------------------------
# Google OAuth y Cloudflare Turnstile
# ---------------------------------------------------------------------------
# Google: configure google.clientId y VITE_GOOGLE_CLIENT_ID con el MISMO
# cliente web, o deje ambos vacíos para deshabilitar el ingreso con Google.
# Los orígenes autorizados se configuran en Google Cloud Console:
#   http://localhost:5173
# Si cambia VITE_GOOGLE_CLIENT_ID, reconstruya el frontend.
google.clientId=

# En local puede quedar false si no se configuran credenciales de prueba.
turnstile.enabled=false
# La secret key es exclusivamente del backend.
turnstile.secretKey=
turnstile.action=login
# Lista sin protocolo, ruta ni puerto.
turnstile.hostnames=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Frontend (Vite): SOLO variables públicas con prefijo VITE_
# ---------------------------------------------------------------------------
# Es una variable de compilación de Vite: después de cambiarla, reconstruya
# el contenedor frontend.
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
